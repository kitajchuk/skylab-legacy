{
  "Blog Information": {
    "title": {
      "type": "StructuredText",
      "config": {
        "single": "heading1, heading2, heading3, heading4, heading5, heading6",
        "label": "Blog Title",
        "placeholder": "Blog Title"
      }
    },
    "uid": {
      "type": "UID",
      "config": {
        "placeholder": "Blog Slug",
        "label": "Blog Slug"
      }
    }
  },
  "Blog Metadata": {
    "image": {
      "type": "Image",
      "config": {
        "constraint": {
          "width": null,
          "height": null
        },
        "thumbnails": [
          {
            "name": "tablet",
            "width": 1600,
            "height": 900
          },
          {
            "name": "mobile",
            "width": 800,
            "height": 450
          }
        ],
        "label": "Blog Image"
      }
    },
    "description": {
      "type": "StructuredText",
      "config": {
        "multi": "paragraph, heading1, heading2, heading3, heading4, heading5, heading6, strong, em, hyperlink",
        "label": "Blog Description",
        "placeholder": "Blog Description"
      }
    },
    "blurb": {
      "type": "StructuredText",
      "config": {
        "multi": "paragraph, strong, em",
        "label": "blurb",
        "placeholder": "Blog Blurb"
      }
    },
    "categories": {
      "type": "Group",
      "fieldset": "Categories",
      "config": {
        "fields": {
          "category": {
            "type": "Select",
            "config": {
              "options": [
                "News"
              ],
              "label": "Select Category",
              "placeholder": "Select Category"
            }
          }
        },
        "repeat": true
      }
    }
  },
  "Blog Content": {
    "type": {
      "type": "Select",
      "config": {
        "options": [
          "Standard",
          "Feature"
        ],
        "label": "Blog Type",
        "placeholder": "Select Type"
      }
    },
    "feature": {
      "config": {
        "fields": {
          "layout": {
            "type": "Select",
            "config": {
              "options": [
                "Left",
                "Center",
                "Right"
              ],
              "label": "layout",
              "placeholder": "Image Position"
            }
          },
          "image": {
            "type": "Image",
            "config": {
              "constraint": {
                "width": 2400,
                "height": null
              },
              "thumbnails": [
                {
                  "name": "tablet",
                  "width": 1600,
                  "height": 900
                },
                {
                  "name": "mobile",
                  "width": 800,
                  "height": 450
                }
              ],
              "label": "Image"
            }
          },
          "imageclip": {
            "type": "Select",
            "config": {
              "options": [
                "Clip Image"
              ],
              "label": "imageclip",
              "placeholder": "Image Clip Path"
            }
          }
        },
        "repeat": false,
        "label": "Feature Layout"
      },
      "type": "Group",
      "fieldset": "Feature"
    },
    "slices": {
      "type": "Slices",
      "fieldset": "Dynamic Content",
      "config": {
        "choices": {
          "lead": {
            "type": "StructuredText",
            "fieldset": "Lead Blog Info Block",
            "config": {
              "placeholder": "Lead Blog Info Block",
              "multi": "heading1,heading2,heading3,heading4,heading5,heading6,paragraph,hyperlink,strong,em"
            }
          },
          "text": {
            "type": "Group",
            "fieldset": "Single Text Block",
            "config": {
              "repeat": false,
              "fields": {
                "text": {
                  "type": "StructuredText",
                  "fieldset": "Text Block",
                  "config": {
                    "placeholder": "Text Block",
                    "multi": "heading1,heading2,heading3,heading4,heading5,heading6,paragraph,hyperlink,strong,em"
                  }
                },
                "meta": {
                  "type": "StructuredText",
                  "fieldset": "Small Text Block",
                  "config": {
                    "placeholder": "Small Text Block",
                    "multi": "paragraph,hyperlink,strong,em"
                  }
                },
                "position": {
                  "type": "Select",
                  "config": {
                    "options": [
                      "Left",
                      "Center",
                      "Right"
                    ],
                    "label": "Select Text Block Position",
                    "placeholder": "Select Text Block Position"
                  }
                },
                "style": {
                  "type": "Select",
                  "config": {
                    "options": [
                      "Big"
                    ],
                    "label": "Select Text Block Style",
                    "placeholder": "Select Text Block Style"
                  }
                }
              }
            }
          },
          "image": {
            "type": "Image",
            "fieldset": "Single Image Block",
            "config": {
              "placeholder": "Single Image Block",
              "constraint": {
                "width": 2400
              },
              "thumbnails": [
                {
                  "name": "tablet",
                  "width": 1600,
                  "height": 900
                },
                {
                  "name": "mobile",
                  "width": 800,
                  "height": 450
                }
              ]
            }
          },
          "videoEmbed": {
            "type": "Embed",
            "fieldset": "Video Embed Block",
            "config": {
              "placeholder": "Video Embed Link"
            }
          },
          "videoLink": {
            "type": "Group",
            "fieldset": "Media Video Link Block",
            "config": {
              "repeat": false,
              "fields": {
                "video": {
                  "type": "Link",
                  "fieldset": "Media Video Link",
                  "config": {
                    "placeholder": "Choose Media Video",
                    "select": "media"
                  }
                },
                "poster": {
                  "type": "Image",
                  "fieldset": "Video Placeholder Image",
                  "config": {
                    "placeholder": "Video Placeholder Image",
                    "constraint": {
                      "width": 2400
                    },
                    "thumbnails": [
                      {
                        "name": "tablet",
                        "width": 1600,
                        "height": 900
                      },
                      {
                        "name": "mobile",
                        "width": 800,
                        "height": 450
                      }
                    ]
                  }
                }
              }
            }
          },
          "parallax": {
            "type": "Group",
            "fieldset": "Parallax Images Block",
            "config": {
              "repeat": false,
              "fields": {
                "background": {
                  "type": "Image",
                  "fieldset": "Background Image",
                  "config": {
                    "placeholder": "Background Image",
                    "constraint": {
                      "width": 2400
                    },
                    "thumbnails": [
                      {
                        "name": "tablet",
                        "width": 1600,
                        "height": 900
                      },
                      {
                        "name": "mobile",
                        "width": 800,
                        "height": 450
                      }
                    ]
                  }
                },
                "image": {
                  "type": "Image",
                  "fieldset": "Foreground Image",
                  "config": {
                    "placeholder": "Foreground Image",
                    "constraint": {
                      "width": 2400
                    },
                    "thumbnails": [
                      {
                        "name": "tablet",
                        "width": 1600,
                        "height": 900
                      },
                      {
                        "name": "mobile",
                        "width": 800,
                        "height": 450
                      }
                    ]
                  }
                },
                "imagePosition": {
                  "type": "Select",
                  "config": {
                    "options": [
                      "Left",
                      "Right"
                    ],
                    "label": "Select Foreground Image Position",
                    "placeholder": "Select Foreground Image Position"
                  }
                },
                "coverStyle": {
                  "type": "Select",
                  "config": {
                    "options": [
                      "Light",
                      "Dark"
                    ],
                    "label": "Select Color Style",
                    "placeholder": "Select Color Style"
                  }
                }
              }
            }
          },
          "diptych": {
            "type": "Group",
            "fieldset": "Diptych Images Block",
            "config": {
              "repeat": false,
              "fields": {
                "left": {
                  "type": "Image",
                  "fieldset": "Left Image",
                  "config": {
                    "placeholder": "Left Image",
                    "constraint": {
                      "width": 2400
                    },
                    "thumbnails": [
                      {
                        "name": "tablet",
                        "width": 1600,
                        "height": 900
                      },
                      {
                        "name": "mobile",
                        "width": 800,
                        "height": 450
                      }
                    ]
                  }
                },
                "right": {
                  "type": "Image",
                  "fieldset": "Right Image",
                  "config": {
                    "placeholder": "Right Image",
                    "constraint": {
                      "width": 2400
                    },
                    "thumbnails": [
                      {
                        "name": "tablet",
                        "width": 1600,
                        "height": 900
                      },
                      {
                        "name": "mobile",
                        "width": 800,
                        "height": 450
                      }
                    ]
                  }
                }
              }
            }
          },
          "textImage": {
            "type": "Group",
            "fieldset": "Text with Image Block",
            "config": {
              "repeat": false,
              "fields": {
                "image": {
                  "type": "Image",
                  "fieldset": "Left Image",
                  "config": {
                    "placeholder": "Left Image",
                    "constraint": {
                      "width": 2400
                    },
                    "thumbnails": [
                      {
                        "name": "tablet",
                        "width": 1600,
                        "height": 900
                      },
                      {
                        "name": "mobile",
                        "width": 800,
                        "height": 450
                      }
                    ]
                  }
                },
                "imageclip": {
                  "type": "Select",
                  "config": {
                    "options": [
                      "Clip Image"
                    ],
                    "label": "imageclip",
                    "placeholder": "Image Clip Path"
                  }
                },
                "text": {
                  "type": "StructuredText",
                  "fieldset": "Text Block",
                  "config": {
                    "placeholder": "Text Block",
                    "multi": "heading1,heading2,heading3,heading4,heading5,heading6,paragraph,hyperlink,strong,em"
                  }
                },
                "textPosition": {
                  "type": "Select",
                  "config": {
                    "options": [
                      "Left",
                      "Right"
                    ],
                    "label": "Select Text Position",
                    "placeholder": "Select Text Position"
                  }
                },
                "meta": {
                  "type": "StructuredText",
                  "fieldset": "Small Text Block",
                  "config": {
                    "placeholder": "Small Text Block",
                    "multi": "paragraph,hyperlink,strong,em"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
