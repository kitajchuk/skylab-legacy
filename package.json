{
  "title": "Skylab Architecture",
  "name": "skylab-www",
  "description": "Website for Skylab Architecture.",
  "private": true,
  "version": "0.1.0",
  "config": {
    "aws_ec2_task_host": "35.160.15.151",
    "aws_ec2_staging_host": "35.161.152.178",
    "aws_ec2_production_host": "35.162.151.95"
  },
  "scripts": {
    "bootstrap": "node skylab.install.js",
    "generate:sitemap": "node ./server/core/sitemap.js",
    "generate:robots": "node ./server/core/robots.js",
    "generate:appcache": "node ./server/generators/appcache.js",
    "start": "echo 'Skylab sandbox is starting...' && (npm run server & npm run watch)",
    "watch": "./node_modules/.bin/webpack --env.sandbox --hide-modules --colors --watch",
    "server": "export NODE_ENV=sandbox ; ./node_modules/.bin/nodemon server/app.js",
    "build": "export NODE_ENV=sandbox ; ./node_modules/.bin/webpack --env.sandbox --progress --profile --display-modules --colors",
    "build:staging": "export NODE_ENV=staging ; ./node_modules/.bin/webpack --env.staging --progress --profile --display-modules --colors -p",
    "build:production": "export NODE_ENV=production ; ./node_modules/.bin/webpack --env.production --progress --profile --display-modules --colors -p",
    "connect:staging": "ssh ec2-user@$npm_package_config_aws_ec2_staging_host -i ./sandbox/skylab.pem",
    "connect:production": "ssh ec2-user@$npm_package_config_aws_ec2_production_host -i ./sandbox/skylab.pem",
    "connect:task": "ssh ec2-user@$npm_package_config_aws_ec2_task_host -i ./sandbox/skylab.pem",
    "deploy:staging": "npm run build:staging ; npm run generate:sitemap ; npm run generate:robots ; npm run generate:appcache ; export NODE_ENV=staging ; export AWS_HOST=${AWS_STAGING_HOST} ; ./skylab.deploy",
    "deploy:production": "npm run build:production ; npm run generate:sitemap ; npm run generate:robots ; npm run generate:appcache ; export NODE_ENV=production ; export AWS_HOST=${AWS_PRODUCTION_HOST} ; ./skylab.deploy",
    "task:imageprocess": "./sandbox/imageprocess"
  },
  "devDependencies": {
    "appcache-manifest": "^2.1.0",
    "autoprefixer": "^6.7.6",
    "babel-core": "^6.23.1",
    "babel-loader": "^6.3.2",
    "babel-preset-es2015": "^6.22.0",
    "browser-sync": "^2.18.8",
    "browser-sync-webpack-plugin": "^1.1.4",
    "compression-webpack-plugin": "^0.4.0",
    "css-loader": "^0.26.2",
    "eslint": "^3.17.0",
    "eslint-loader": "^1.6.3",
    "expose-loader": "^0.7.3",
    "fg-loadcss": "^0.2.4",
    "fg-loadjs": "^1.0.0",
    "file-loader": "^0.10.1",
    "hammerjs": "^2.0.8",
    "node-sass": "^4.5.0",
    "nodemon": "^1.11.0",
    "paramalama": "~0.2",
    "postcss": "^5.2.15",
    "postcss-cssnext": "^2.9.0",
    "postcss-import": "^9.1.0",
    "postcss-loader": "^1.3.3",
    "properjs-controller": "~0.2",
    "properjs-debounce": "^0.2.0",
    "properjs-easing": "~0.2",
    "properjs-hobo": "^0.3.10",
    "properjs-imageloader": ">=0.3.1",
    "properjs-mediabox": "~0.3",
    "properjs-pagecontroller": "~0.4",
    "properjs-resizecontroller": "~0.2",
    "properjs-router": "^0.3.7",
    "properjs-s3": "^0.1.5",
    "properjs-scroll2": "~0.2",
    "properjs-scrollcontroller": "~0.2",
    "properjs-template": "~0.2",
    "properjs-throttle": "^0.3.0",
    "properjs-tween": "~0.2",
    "sass-loader": "^6.0.2",
    "webpack": "^2.2.1"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/thisdesign/skylab-www.git"
  },
  "bugs": {
    "url": "https://github.com/thisdesign/skylab-www/issues"
  },
  "licenses": [
    {
      "type": "MIT",
      "url": "https://github.com/thisdesign/skylab-www/blob/master/LICENSE"
    }
  ],
  "keywords": [],
